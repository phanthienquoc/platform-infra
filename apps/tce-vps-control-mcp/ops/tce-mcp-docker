#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
shift || true

valid_container() {
  [[ "${1:-}" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$ ]]
}

case "$action" in
  ps)
    [[ $# -eq 0 ]] || exit 64
    exec /usr/bin/docker ps --no-trunc --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'
    ;;
  logs)
    [[ $# -eq 2 ]] || exit 64
    valid_container "$1" || exit 64
    [[ "$2" =~ ^[0-9]{1,4}$ ]] && (( 10#$2 >= 1 && 10#$2 <= 1000 )) || exit 64
    exec /usr/bin/docker logs --tail "$2" "$1" 2>&1
    ;;
  *)
    echo "Unsupported Docker operation." >&2
    exit 64
    ;;
esac
